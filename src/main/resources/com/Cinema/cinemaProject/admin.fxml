<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.Cinema.cinemaProject.AdminController">

   <!-- Thanh điều hướng: Trang chủ | Vé đã đặt | Account | Chỉnh sửa (chỉ admin) ... Đăng xuất -->
   <top>
      <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-background-color: #2b2b40;">
         <padding>
            <Insets bottom="10.0" left="16.0" right="16.0" top="10.0" />
         </padding>
         <Button fx:id="homeButton" onAction="#handleHome" text="Trang chủ"
                 style="-fx-background-color: transparent; -fx-text-fill: white;" />
         <Button fx:id="ticketsButton" onAction="#handleTickets" text="Vé đã đặt"
                 style="-fx-background-color: transparent; -fx-text-fill: white;" />
         <Button fx:id="accountButton" onAction="#handleAccount" text="Account"
                 style="-fx-background-color: transparent; -fx-text-fill: white;" />
         <Button fx:id="editButton" onAction="#handleEdit" text="Chỉnh sửa"
                 style="-fx-background-color: #ff9800; -fx-text-fill: white; -fx-font-weight: bold;" />
         <Region HBox.hgrow="ALWAYS" />
         <Label fx:id="userLabel" style="-fx-text-fill: #cfcfe0;" />
         <Button fx:id="logoutButton" onAction="#handleLogout" text="Đăng xuất" />
      </HBox>
   </top>

   <center>
      <TabPane tabClosingPolicy="UNAVAILABLE">
         <!-- ==================== TAB 1: QUẢN LÝ PHIM ==================== -->
         <Tab text="Quản lý phim">
            <HBox spacing="20.0">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>

               <VBox HBox.hgrow="ALWAYS" spacing="10.0"
                     style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dddddd; -fx-border-radius: 8;">
                  <padding>
                     <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                  </padding>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <Label text="Danh sách phim" style="-fx-font-size: 17px; -fx-font-weight: bold;" />
                     <Region HBox.hgrow="ALWAYS" />
                     <Button onAction="#handleRefreshMovies" text="Làm mới" />
                  </HBox>
                  <TableView fx:id="moviesTable" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="movieIdCol" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="movieTitleCol" prefWidth="200.0" text="Tên phim" />
                        <TableColumn fx:id="movieDurationCol" prefWidth="95.0" text="Thời lượng" />
                        <TableColumn fx:id="movieStatusCol" prefWidth="105.0" text="Trạng thái" />
                        <TableColumn fx:id="moviePosterCol" prefWidth="220.0" text="Poster URL" />
                     </columns>
                  </TableView>
               </VBox>

               <VBox prefWidth="360.0" minWidth="340.0" spacing="10.0"
                     style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dddddd; -fx-border-radius: 8;">
                  <padding>
                     <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                  </padding>
                  <Label text="Thông tin phim" style="-fx-font-size: 17px; -fx-font-weight: bold;" />
                  <Label fx:id="selectedMovieLabel" text="Đang ở chế độ thêm phim mới"
                         style="-fx-text-fill: #666666; -fx-font-size: 12px;" />

                  <Label text="Tên phim (title) *" style="-fx-font-weight: bold;" />
                  <TextField fx:id="movieTitleField" promptText="Nhập tên phim" />

                  <Label text="Thời lượng (phút) *" style="-fx-font-weight: bold;" />
                  <TextField fx:id="movieDurationField" promptText="Ví dụ: 120" />

                  <Label text="Poster URL" style="-fx-font-weight: bold;" />
                  <TextField fx:id="moviePosterField" promptText="https://..." />

                  <Label text="Trạng thái" style="-fx-font-weight: bold;" />
                  <ComboBox fx:id="movieStatusCombo" maxWidth="Infinity" />

                  <Label text="Mô tả (description)" style="-fx-font-weight: bold;" />
                  <TextArea fx:id="movieDescArea" prefRowCount="4" wrapText="true"
                            promptText="Nhập mô tả phim..." />

                  <Label fx:id="movieFeedbackLabel" wrapText="true"
                         visible="false" managed="false" />

                  <HBox spacing="8.0">
                     <Button onAction="#handleAddMovie" text="Thêm phim" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                             style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold;" />
                     <Button fx:id="updateMovieBtn" onAction="#handleUpdateMovie" text="Lưu sửa"
                             HBox.hgrow="ALWAYS" maxWidth="Infinity"
                             style="-fx-background-color: #1565c0; -fx-text-fill: white; -fx-font-weight: bold;" />
                  </HBox>
                  <HBox spacing="8.0">
                     <Button fx:id="stopMovieBtn" onAction="#handleStopMovie" text="Xóa (STOPPED)"
                             HBox.hgrow="ALWAYS" maxWidth="Infinity"
                             style="-fx-background-color: #c62828; -fx-text-fill: white;" />
                     <Button onAction="#handleClearMovieForm" text="Xóa trắng form"
                             HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                  </HBox>
               </VBox>
            </HBox>
         </Tab>

         <!-- ==================== TAB 2: QUẢN LÝ LỊCH CHIẾU ==================== -->
         <Tab text="Quản lý lịch chiếu">
            <HBox spacing="20.0">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>

               <VBox HBox.hgrow="ALWAYS" spacing="10.0"
                     style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dddddd; -fx-border-radius: 8;">
                  <padding>
                     <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                  </padding>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <Label text="Danh sách suất chiếu" style="-fx-font-size: 17px; -fx-font-weight: bold;" />
                     <Region HBox.hgrow="ALWAYS" />
                     <Button onAction="#handleRefreshShowtimes" text="Làm mới" />
                  </HBox>
                  <TableView fx:id="showtimesTable" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="stIdCol" prefWidth="45.0" text="ID" />
                        <TableColumn fx:id="stMovieCol" prefWidth="175.0" text="Phim" />
                        <TableColumn fx:id="stRoomCol" prefWidth="90.0" text="Phòng" />
                        <TableColumn fx:id="stStartCol" prefWidth="130.0" text="Bắt đầu" />
                        <TableColumn fx:id="stEndCol" prefWidth="130.0" text="Kết thúc" />
                        <TableColumn fx:id="stPriceCol" prefWidth="90.0" text="Giá vé" />
                        <TableColumn fx:id="stStatusCol" prefWidth="90.0" text="Trạng thái" />
                        <TableColumn fx:id="stBookedCol" prefWidth="70.0" text="Vé đặt" />
                     </columns>
                  </TableView>
               </VBox>

               <VBox prefWidth="360.0" minWidth="340.0" spacing="10.0"
                     style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dddddd; -fx-border-radius: 8;">
                  <padding>
                     <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                  </padding>
                  <Label text="Thông tin suất chiếu" style="-fx-font-size: 17px; -fx-font-weight: bold;" />
                  <Label fx:id="selectedShowtimeLabel" text="Đang ở chế độ thêm suất chiếu mới"
                         style="-fx-text-fill: #666666; -fx-font-size: 12px;" />

                  <Label text="Chọn phim *" style="-fx-font-weight: bold;" />
                  <ComboBox fx:id="stMovieCombo" maxWidth="Infinity" />

                  <Label text="Chọn phòng *" style="-fx-font-weight: bold;" />
                  <ComboBox fx:id="stRoomCombo" maxWidth="Infinity" />

                  <Label text="Ngày và giờ bắt đầu *" style="-fx-font-weight: bold;" />
                  <HBox spacing="8.0">
                     <DatePicker fx:id="stDatePicker" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                     <TextField fx:id="stTimeField" prefWidth="95.0" promptText="HH:mm" />
                  </HBox>

                  <Label text="Giờ kết thúc (tự tính = bắt đầu + thời lượng phim)" style="-fx-font-weight: bold;" />
                  <Label fx:id="stEndTimePreviewLabel" text="—"
                         style="-fx-background-color: #f3f4f6; -fx-padding: 8 10 8 10; -fx-background-radius: 4; -fx-text-fill: #333333;"
                         maxWidth="Infinity" />

                  <Label text="Giá vé cơ bản (VNĐ) *" style="-fx-font-weight: bold;" />
                  <TextField fx:id="stPriceField" promptText="Ví dụ: 90000" />

                  <Label fx:id="stWarningLabel" wrapText="true"
                         style="-fx-text-fill: #e65100; -fx-font-weight: bold;"
                         visible="false" managed="false" />

                  <Label fx:id="stFeedbackLabel" wrapText="true"
                         visible="false" managed="false" />

                  <HBox spacing="8.0">
                     <Button onAction="#handleAddShowtime" text="Thêm suất" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                             style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold;" />
                     <Button fx:id="updateShowtimeBtn" onAction="#handleUpdateShowtime" text="Lưu sửa"
                             HBox.hgrow="ALWAYS" maxWidth="Infinity"
                             style="-fx-background-color: #1565c0; -fx-text-fill: white; -fx-font-weight: bold;" />
                  </HBox>
                  <HBox spacing="8.0">
                     <Button fx:id="cancelShowtimeBtn" onAction="#handleCancelShowtime" text="Hủy suất (CANCELLED)"
                             HBox.hgrow="ALWAYS" maxWidth="Infinity"
                             style="-fx-background-color: #c62828; -fx-text-fill: white;" />
                     <Button onAction="#handleClearShowtimeForm" text="Xóa trắng form"
                             HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                  </HBox>
               </VBox>
            </HBox>
         </Tab>

         <!-- ==================== TAB 3: QUẢN LÝ PHÒNG & GHẾ ==================== -->
         <Tab text="Quản lý phòng &amp; ghế">
            <HBox spacing="20.0">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>

               <VBox prefWidth="420.0" minWidth="380.0" spacing="10.0"
                     style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dddddd; -fx-border-radius: 8;">
                  <padding>
                     <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                  </padding>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <Label text="Danh sách phòng chiếu" style="-fx-font-size: 17px; -fx-font-weight: bold;" />
                     <Region HBox.hgrow="ALWAYS" />
                     <Button onAction="#handleRefreshRooms" text="Làm mới" />
                  </HBox>
                  <TableView fx:id="roomsTable" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="roomNameCol" prefWidth="95.0" text="Phòng" />
                        <TableColumn fx:id="roomTotalCol" prefWidth="70.0" text="Tổng ghế" />
                        <TableColumn fx:id="roomAvailCol" prefWidth="75.0" text="Khả dụng" />
                        <TableColumn fx:id="roomMaintCol" prefWidth="75.0" text="Bảo trì" />
                        <TableColumn fx:id="roomUnavailCol" prefWidth="75.0" text="Hỏng" />
                     </columns>
                  </TableView>
               </VBox>

               <VBox HBox.hgrow="ALWAYS" spacing="14.0"
                     style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dddddd; -fx-border-radius: 8;">
                  <padding>
                     <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                  </padding>
                  <Label fx:id="roomSeatsTitleLabel" text="Sơ đồ ghế (chọn một phòng ở bên trái)"
                         style="-fx-font-size: 17px; -fx-font-weight: bold;" />

                  <HBox alignment="CENTER_LEFT" spacing="16.0">
                     <Label text="■ AVAILABLE (Thường)" style="-fx-text-fill: #2e7d32; -fx-font-weight: bold;" />
                     <Label text="■ AVAILABLE (VIP)" style="-fx-text-fill: #1565c0; -fx-font-weight: bold;" />
                     <Label text="■ MAINTENANCE" style="-fx-text-fill: #ef6c00; -fx-font-weight: bold;" />
                     <Label text="■ UNAVAILABLE" style="-fx-text-fill: #c62828; -fx-font-weight: bold;" />
                  </HBox>

                  <Label text="MÀN HÌNH CHIẾU" alignment="CENTER" maxWidth="Infinity"
                         style="-fx-background-color: #e0e0e0; -fx-padding: 6; -fx-font-weight: bold; -fx-background-radius: 4;" />

                  <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                     <GridPane fx:id="seatsGrid" hgap="8.0" vgap="8.0" alignment="CENTER">
                        <padding>
                           <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                        </padding>
                     </GridPane>
                  </ScrollPane>

                  <Separator />

                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <Label fx:id="selectedSeatLabel" text="Chưa chọn ghế nào."
                            style="-fx-font-weight: bold;" HBox.hgrow="ALWAYS" />
                     <ComboBox fx:id="seatStatusCombo" prefWidth="160.0" />
                     <Button fx:id="updateSeatStatusBtn" onAction="#handleUpdateSeatStatus"
                             text="Cập nhật trạng thái"
                             style="-fx-background-color: #1565c0; -fx-text-fill: white; -fx-font-weight: bold;" />
                  </HBox>

                  <Label fx:id="seatFeedbackLabel" wrapText="true"
                         visible="false" managed="false" />
               </VBox>
            </HBox>
         </Tab>
      </TabPane>
   </center>
</BorderPane>
