<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Vé của tôi: xem thông tin vé -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cinema.controller.MyTicketsController" spacing="10">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <TableView fx:id="tblTickets" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="colTicketId" text="Mã vé"/>
            <TableColumn fx:id="colMovie"    text="Phim"/>
            <TableColumn fx:id="colShowtime" text="Suất chiếu"/>
            <TableColumn fx:id="colRoom"     text="Phòng"/>
            <TableColumn fx:id="colSeat"     text="Ghế"/>
            <TableColumn fx:id="colPrice"    text="Giá"/>
            <TableColumn fx:id="colCreatedAt" text="Ngày đặt"/>
            <TableColumn fx:id="colStatus"   text="Trạng thái"/>
        </columns>
    </TableView>
</VBox>
