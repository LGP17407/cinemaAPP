<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="689.0" prefWidth="897.0" spacing="12.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.Cinema.cinemaProject.LoginController">
   <padding>
      <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
   </padding>
   <Label fx:id="messageLabel" style="-fx-text-fill: red;" />
   <Label style="-fx-font-size: 22px;" text="Đăng nhập" />
   <TextField fx:id="emailField" promptText="Email" />
   <PasswordField fx:id="passwordField" promptText="Mật khẩu" />
   <Hyperlink onAction="#goToRegister" prefHeight="5.0" prefWidth="156.0" text="Chưa có tài khoản? Đăng ký" />
   <Button defaultButton="true" maxWidth="Infinity" onAction="#handleLogin" text="Đăng nhập" />
</VBox>
