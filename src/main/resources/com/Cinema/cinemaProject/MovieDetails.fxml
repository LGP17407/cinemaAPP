<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<!-- POPUP: Chi tiết phim. Nút "Đặt vé" -> mở Booking. Scene root nên tự nạp styles.css -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            styleClass="app-root" prefWidth="640" prefHeight="520"
            fx:controller="com.Cinema.cinemaProject.MovieDetailController">

    <stylesheets>
        <URL value="@../style.css"/>
    </stylesheets>

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <left>
        <ImageView fx:id="imgPoster" fitWidth="200" fitHeight="300" preserveRatio="true"
                   BorderPane.alignment="TOP_LEFT"/>
    </left>

    <center>
        <VBox spacing="10">
            <padding><Insets left="20"/></padding>
            <Label fx:id="lblTitle" styleClass="page-title" wrapText="true"/>
            <Label fx:id="lblGenre"/>
            <Label fx:id="lblDuration"/>
            <Label fx:id="lblReleaseDate"/>
            <Label fx:id="lblStatus"/>
            <TextArea fx:id="txtDescription" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding><Insets top="16"/></padding>
            <Button text="Đóng" styleClass="btn-secondary" onAction="#onClose"/>
            <!-- Controller: btnBook.setDisable(!movie.isNowShowing()) -->
            <Button fx:id="btnBook" text="Đặt vé" styleClass="btn-accent" onAction="#onBook"/>
        </HBox>
    </bottom>
</BorderPane>