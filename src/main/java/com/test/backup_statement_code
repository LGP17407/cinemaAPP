			    	if( i == 1)
			    		System.out.print(rs.getString(i));
			    	else
			    		System.out.print("\t\t" + rs.getString(i));
			    }
			    System.out.println();                       // xuống dòng sau mỗi dòng dữ liệu
			}
		}
		catch (SQLException ex) {
			System.out.println("SQLException: " + ex.getMessage());
		}
		finally {
			if (rs != null)
				try {
					rs.close();
					
